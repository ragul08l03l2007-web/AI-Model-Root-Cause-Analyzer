# AI Provider Configuration Example
# Copy this file to .env and set your API keys

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI-compatible API (OpenAI, DeepSeek, Groq, OpenRouter)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Provider selection ('gemini', 'openai', 'ollama', or omit for auto-detection)
# AI_PROVIDER=gemini
